# Required for the CLI.
# Account ID: Cloudflare dashboard, right-hand side of the account overview.
CLOUDFLARE_ACCOUNT_ID=
# API token with the "Workers AI" permission (Account > Workers AI > Read).
WORKERS_AI_API_TOKEN=

# Only needed for scanning r2://bucket/prefix sources.
# Create an R2 API token with read access under R2 > Manage API tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
